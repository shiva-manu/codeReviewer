# Copy for local runs: cp .env.example .env
# Never commit .env (already in .gitignore).

# 1. OpenCode Go key — required in CI as secret OPENCODE_API_KEY.
#    You already have this, so no setup notes here.
#    src/index.ts accepts either name:
OPENCODE_API_KEY=
# OPENAI_API_KEY=

# 2. GitHub token — NOT needed in Actions (auto-provided as github.token).
#    Only set this for local `npm run review` runs:
GITHUB_TOKEN=

# Optional (have defaults in action.yml):
# INPUT_MODEL=muse-spark-1.3-contributor
# INPUT_MAX_FILES=20
